<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnCall.Mobile.MainPage"
             Title="OnCall">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="18" MaximumWidthRequest="520">
            <Label Text="OnCall" FontSize="36" FontAttributes="Bold" />
            <Label Text="Legal help when you need it" FontSize="18" TextColor="Gray" />

            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />

            <VerticalStackLayout x:Name="AuthPanel" Spacing="12">
                <Label Text="Sign in or create an account" FontSize="22" FontAttributes="Bold" />
                <Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email" />
                <Entry x:Name="PasswordEntry" Placeholder="Password (at least 6 characters)" IsPassword="True" />
                <Button Text="Sign In" Clicked="OnSignInClicked" />
                <Button Text="Create Account" Clicked="OnRegisterClicked" />
                <Label Text="Development currently uses the local Firebase emulators." FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="HomePanel" IsVisible="False" Spacing="14">
                <Label x:Name="WelcomeLabel" FontSize="24" FontAttributes="Bold" />
                <Border Stroke="#DDDDDD" StrokeShape="RoundRectangle 12" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Account" FontAttributes="Bold" />
                        <Label x:Name="RoleLabel" />
                        <Label x:Name="EmailLabel" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ClientPanel" Spacing="12">
                    <Label Text="Request legal help" FontSize="20" FontAttributes="Bold" />
                    <Picker x:Name="IncidentPicker" Title="Type of help">
                        <Picker.Items><x:String>Traffic</x:String><x:String>Criminal</x:String><x:String>Other</x:String></Picker.Items>
                    </Picker>
                    <Button Text="Use My Current Location" Clicked="OnUseLocationClicked" />
                    <Label x:Name="LocationLabel" Text="Location has not been collected." TextColor="Gray" />
                    <Button Text="Request a Lawyer" Clicked="OnRequestLawyerClicked" BackgroundColor="#B42318" TextColor="White" />
                    <Border x:Name="ActiveRequestPanel" IsVisible="False" Stroke="#B42318" StrokeShape="RoundRectangle 12" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Active request" FontAttributes="Bold" />
                            <Label x:Name="RequestStatusLabel" />
                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Refresh" Clicked="OnRefreshRequestClicked" />
                                <Button Text="Cancel Request" Clicked="OnCancelRequestClicked" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="LawyerPanel" IsVisible="False" Spacing="12">
                    <Label Text="Lawyer dashboard" FontSize="20" FontAttributes="Bold" />
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="Available for requests" VerticalOptions="Center" />
                        <Switch x:Name="AvailabilitySwitch" Toggled="OnAvailabilityToggled" />
                    </HorizontalStackLayout>
                    <Button Text="Refresh Incoming Requests" Clicked="OnRefreshOffersClicked" />
                    <CollectionView x:Name="OffersView" SelectionMode="Single" SelectionChanged="OnOfferSelected" EmptyView="No incoming requests.">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Stroke="#DDDDDD" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,4">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding IncidentType}" FontAttributes="Bold" />
                                        <Label Text="{Binding City}" />
                                        <Label Text="Tap to accept" FontSize="12" TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <Button x:Name="JoinMeetingButton" IsVisible="False" Text="Join Secure Video Call" Clicked="OnJoinMeetingClicked" />
                <Button x:Name="CompleteRequestButton" IsVisible="False" Text="Complete Legal Session" Clicked="OnCompleteRequestClicked" />

                <Button Text="Sign Out" Clicked="OnSignOutClicked" />
            </VerticalStackLayout>

            <Label x:Name="StatusLabel" TextColor="#B42318" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
